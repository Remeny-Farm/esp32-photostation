# Build output
build/
firmware/**/build/

# Secrets and local configuration
firmware/station/secrets.local.env
secrets.local.env*
*.env
!*.env.example
*.pem
*.key

# Local backups, flash dumps (they hold NVS secrets) and logs
backup/
*.bin
*.elf
*.log

# Python
*.pyc
__pycache__/

# OS and tooling
.DS_Store
.claude/
.superpowers/

# Third-party mechanical references (datasheets, vendor CAD): download locally, do not commit.
# Sources are listed in hardware/case/ref/DIMENSIONS.md.
hardware/case/ref/*
!hardware/case/ref/DIMENSIONS.md
